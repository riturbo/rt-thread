			clocks = <0xdb>;
			clock-names = "apb_pclk";
			cpu = <0xd8>;

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xe4>;
						phandle = <0xef>;
					};
				};
			};
		};

		etm@06e40000 {
			compatible = "arm,coresight-etm4x\0arm,primecell";
			reg = <0x00 0x6e40000 0x00 0x1000>;
			clocks = <0xdb>;
			clock-names = "apb_pclk";
			cpu = <0xd9>;

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xe5>;
						phandle = <0xf0>;
					};
				};
			};
		};

		etm@06f40000 {
			compatible = "arm,coresight-etm4x\0arm,primecell";
			reg = <0x00 0x6f40000 0x00 0x1000>;
			clocks = <0xdb>;
			clock-names = "apb_pclk";
			cpu = <0xda>;

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xe6>;
						phandle = <0xf1>;
					};
				};
			};
		};

		css_funnel {
			compatible = "arm,coresight-static-funnel";
			clocks = <0xdb>;
			clock-names = "apb_pclk";

			out-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0xe7>;
						phandle = <0xdc>;
					};
				};
			};

			in-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port {
					reg = <0x04>;

					endpoint {
						remote-endpoint = <0xe8>;
						phandle = <0xe9>;
					};
				};
			};
		};

		funnel_cpu1 {
			compatible = "arm,coresight-static-funnel";
			clocks = <0xdb>;
			clock-names = "apb_pclk";

			out-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0xe9>;
						phandle = <0xe8>;
					};
				};
			};

			in-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0xea>;
						phandle = <0xdf>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0xeb>;
						phandle = <0xe0>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						remote-endpoint = <0xec>;
						phandle = <0xe1>;
					};
				};

				port@3 {
					reg = <0x03>;

					endpoint {
						remote-endpoint = <0xed>;
						phandle = <0xe2>;
					};
				};

				port@4 {
					reg = <0x04>;

					endpoint {
						remote-endpoint = <0xee>;
						phandle = <0xe3>;
					};
				};

				port@5 {
					reg = <0x05>;

					endpoint {
						remote-endpoint = <0xef>;
						phandle = <0xe4>;
					};
				};

				port@6 {
					reg = <0x06>;

					endpoint {
						remote-endpoint = <0xf0>;
						phandle = <0xe5>;
					};
				};

				port@7 {
					reg = <0x07>;

					endpoint {
						remote-endpoint = <0xf1>;
						phandle = <0xe6>;
					};
				};
			};
		};
	};

	aliases {
		serial0 = "/soc/serial@60520000";
		serial1 = "/soc/serial@604d0000";
		serial2 = "/soc/serial@60500000";
	};

	memory@50000000 {
		device_type = "memory";
		reg = <0x00 0x9f200000 0x00 0x10000000 >;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		crashdump {
			compatibel = "crashdump";
			reg = <0x00 0x9f200000 0x00 0x200000>;
		};


	};

	chosen {
		bootargs = "skip_initramfs noinitrd root=/dev/mmcblk0p15 rootfstype=ext4 rootwait ro highres=1 nr_cpus=8 earlycon initcall_debug=0 loglevel=4 console=ttyS0,115200n8 fb.lockless_register_fb=1 psplash=false init=/sbin/init logbuf.console=ap1 logbuf.timestamp=rtc no_console_suspend";
		stdout-path = "serial0";
		linux,initrd-start = <0xab000000>;
		linux,initrd-end = <0xad000000>;
	};

	fixed-vdd_12 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_12v";
		regulator-min-microvolt = <0xb71b00>;
		regulator-max-microvolt = <0xb71b00>;
	};

	fixed-vdd_3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_3v3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		phandle = <0x24>;
	};

	fixed-vdd_1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_1v8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		phandle = <0x12>;
	};

	sound@ak7738 {
		compatible = "semidrive,x9-ms-mach";
		status = "okay";
	};

	sound@tlv320aic3x {
		compatible = "semidrive,x9-ref-tlv320aic3x";
		semidrive,audio-codec = <0xf2>;
		semidrive,afe-i2s = <0xf3>;
		semidrive,jack-gpio = <0x2a 0x06 0x00>;
		status = "okay";
	};

	panel0-backlight {
		compatible = "sd,rpmsg-bl";
		bl_screen-id = <0x01>;
		pwms = <0xf4 0x00 0x9c40 0x01>;
		brightness-levels = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f 0x30 0x31 0x32 0x33 0x34 0x35 0x36 0x37 0x38 0x39 0x3a 0x3b 0x3c 0x3d 0x3e 0x3f 0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b 0x4c 0x4d 0x4e 0x4f 0x50 0x51 0x52 0x53 0x54 0x55 0x56 0x57 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63 0x64>;
		default-brightness-level = <0x46>;
		status = "okay";
	};

	panel1-backlight {
		compatible = "sd,rpmsg-bl";
		bl_screen-id = <0x02>;
		pwms = <0xf4 0x01 0x9c40 0x01>;
		brightness-levels = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f 0x30 0x31 0x32 0x33 0x34 0x35 0x36 0x37 0x38 0x39 0x3a 0x3b 0x3c 0x3d 0x3e 0x3f 0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b 0x4c 0x4d 0x4e 0x4f 0x50 0x51 0x52 0x53 0x54 0x55 0x56 0x57 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63 0x64>;
		default-brightness-level = <0x46>;
		status = "okay";
	};

	secure_virtio {
		compatible = "sd,virtio-service";
		reg = <0x00 0x8b520000 0x00 0x40000>;
		mboxes = <0x84 0xe6 0xe601>;
		status = "okay";
	};

	mp_virtio {
		compatible = "sd,virtio-service";
		reg = <0x00 0x8b920000 0x00 0x40000>;
		mboxes = <0x84 0xea 0xea02>;
		status = "okay";
	};

	str_trace {
		compatible = "sd,str-trace";
		rproc = <0x03>;
		status = "okay";
	};

	logbuf {
		compatible = "semidrive, logbuf";
		reg = <0x00 0xe3f00000 0x00 0x200000>;
		regctl = <0xf5 0x07>;
		status = "okay";
	};

	soc_sram@vpu_sram {
		compatible = "soc-sram";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		reg = <0x00 0x200000 0x00 0x40000 0x00 0x240000 0x00 0x40000 0x00 0x280000 0x00 0x80000>;
		reg-names = "sram_coda988\0sram_wave412\0sram_wave521";
		phandle = <0x4f>;
	};

	firmware {

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};
};

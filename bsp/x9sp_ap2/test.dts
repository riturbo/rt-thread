/dts-v1/;

/ {
	compatible = "semidrive,thang";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "Semidrive thang X9SP AP1 MS Board";

	clk_cpu1 {
		compatible = "simple-bus";
		status = "okay";

		CPU1A_0 {
			compatible = "semidrive,virt_clk";
			#clock-cells = <0x00>;
			sdrv,clk-id = <0x102>;
			sdrv,clk-cache;
			phandle = <0xc8>;
		};

		CPU1B_0 {
			compatible = "semidrive,virt_clk";
			#clock-cells = <0x00>;
			sdrv,clk-id = <0x108>;
			sdrv,clk-cache;
